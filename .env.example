# Скопируйте в .env и при необходимости измените. Без .env используются значения по умолчанию.

# Порт, на котором открывается приложение: http://localhost:8080
APP_PORT=8080
# Порт Prometheus при запуске с профилем мониторинга: docker compose --profile monitoring up
# PROMETHEUS_PORT=9090
# Порт Grafana с готовой панелью конвейера (тот же профиль monitoring)
# GRAFANA_PORT=3000

# База данных
POSTGRES_PASSWORD=credit

# Секрет для подписи токенов входа. На внешнем сервере обязательно замените.
JWT_SECRET=change-me-in-production

# ИИ-функции (необязательно). Основной сценарий работает и без них.
AI_ENABLED=false
# Любой сервис с API в формате OpenAI:
#   локальная Ollama:                  http://host.docker.internal:11434/v1, ключ не нужен
#   другой сервис с открытыми весами:  адрес /v1, ключ и имя модели из его документации
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:4b
# Сколько секунд ждать ответа модели; если не дождались — подбор работает на правилах
LLM_TIMEOUT_SECONDS=40

# Сколько заявок обработчик конвейера ведёт одновременно (потоков на процесс)
WORKER_CONCURRENCY=4

# Только для публикации на внешнем сервере с HTTPS (docs/deploy.md)
# DOMAIN=203-0-113-10.sslip.io
