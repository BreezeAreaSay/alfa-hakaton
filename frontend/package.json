{
  "name": "credit-cabinet-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "demo:check": "node scripts/demo-selfcheck.mjs",
    "demo:capture": "node scripts/capture-demo-fixtures.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@alfalab/core-components": "50.37.0",
    "@alfalab/core-components-config": "1.1.0",
    "@alfalab/core-components-stack-context": "1.0.1",
    "@alfalab/icons-glyph": "2.293.0",
    "@alfalab/icons-logotype": "2.37.0",
    "@fontsource/onest": "5.3.1",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
