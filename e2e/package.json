{
  "name": "smart-credit-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Сквозные тесты интерфейса: на запущенном стеке docker compose или на демо-версии без сервера",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:demo": "E2E_DEMO=1 playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json",
    "test:a11y": "E2E_DEMO=1 E2E_A11Y=1 playwright test --project=a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
